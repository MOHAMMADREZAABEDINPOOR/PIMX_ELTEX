{
  "name": "pimx-eltex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run pages:build && wrangler pages deploy .pages-output --project-name pimxeltex",
    "deploy:worker-backend": "opennextjs-cloudflare build && wrangler deploy --config wrangler.worker.toml",
    "pages:build": "node scripts/build-pages.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pimx-eltex-db --local",
    "db:seed:local": "wrangler d1 execute pimx-eltex-db --local --file scripts/seed-local.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply pimx-eltex-db --remote",
    "content:publish:muse-1": "node scripts/publish-muse-spark-prompt-1.mjs",
    "content:sync:muse": "node scripts/sync-muse-spark-episode.mjs",
    "test:previews": "node scripts/verify-live-previews.mjs",
    "test:smtp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/smtp-client.test.mjs",
    "test:comment-reactions": "node scripts/verify-comment-reactions.mjs",
    "test:comment-deletion": "node scripts/verify-comment-deletion.mjs",
    "content:capture-previews": "node scripts/capture-project-previews.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  }
}
